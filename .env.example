# =============================================================
# BillChat Backend — Environment Variables (cloud deployment)
# =============================================================
# Local dev   : copy this file to `.env` and fill real values.
# Cloud deploy: paste these same keys into your host's environment
#               variables (Render / Railway / Fly.io / VPS) — do NOT
#               commit a real `.env`.
#
# NOTE: cloud hosts (Render/Railway) set `PORT` themselves and
#       override it automatically. The app always reads
#       process.env.PORT with 3000 as fallback.
# =============================================================

# ---- Server ----
PORT=3000
NODE_ENV=production
# Comma-separated origins allowed by CORS (the Flutter web host, if any).
CLIENT_URL=https://your-frontend-domain.com

# ---- MongoDB Atlas ----
# Obtain from Atlas: Database > Connect > Drivers. Use the full connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/billchat?retryWrites=true&w=majority

# ---- JWT Auth (use long random strings, min 32 chars) ----
JWT_SECRET=change_this_to_a_very_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ---- E2EE (server never stores plaintext; used to encrypt push payloads) ----
# A static symmetric key the SERVER uses ONLY for transport-level encryption of
# delivery payloads. The TRUE E2EE layer lives client-side (see Flutter helper).
APP_SERVER_SECRET=change_this_to_another_long_secret_32_chars_min

# ---- Cloudinary (media & stickers) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- OTP (login & registration via WhatsApp) ----
# Kode OTP berlaku 5 menit, kirim ulang minimal 60 detik sekali.
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=8
# Secret untuk hashing kode OTP. Gunakan string acak panjang.
OTP_HASH_SECRET=change_this_to_a_long_random_otp_secret

# ---- WhatsApp Gateway untuk mengirim OTP ----
# Pilihan provider: fonnte | cloud | twilio | dev
#   dev    -> kode OTP hanya dicetak di log server & dikembalikan ke app
#             (untuk testing tanpa kredensial WhatsApp).
#   auto   -> otomatis memilih provider yang kredensialnya terisi.
WHATSAPP_PROVIDER=auto

# Opsi 1: Fonnte (https://fonnte.com) — populer di Indonesia.
FONNTE_TOKEN=

# Opsi 2: WhatsApp Cloud API (Meta).
# Free-form text hanya bisa dikirim dalam 24 jam terakhir pelanggan menghubungi
# Anda. Untuk OTP di luar jendela itu, buat template kategori AUTHENTICATION
# lalu isi WHATSAPP_TEMPLATE_NAME + WHATSAPP_TEMPLATE_LANG.
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=id
WHATSAPP_GRAPH_VERSION=v22.0

# Opsi 3: Twilio WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Contoh: +14155238886
TWILIO_WHATSAPP_FROM=

# ---- Optional: Email (notifications) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=your_smtp_password
