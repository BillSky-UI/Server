# =============================================================
# BillChat Backend — Environment Variables (cloud deployment)
# =============================================================
# Local dev   : copy this file to `.env` and fill real values.
# Cloud deploy: paste these same keys into your host's environment
#               variables (Render / Railway / Fly.io / VPS) — do NOT
#               commit a real `.env`.
#
# NOTE: cloud hosts (Render/Railway) set `PORT` themselves and
#       override it automatically. The app always reads
#       process.env.PORT with 3000 as fallback.
# =============================================================

# ---- Server ----
PORT=3000
NODE_ENV=production
# Comma-separated origins allowed by CORS (the Flutter web host, if any).
CLIENT_URL=https://your-frontend-domain.com

# ---- MongoDB Atlas ----
# Obtain from Atlas: Database > Connect > Drivers. Use the full connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/billchat?retryWrites=true&w=majority

# ---- JWT Auth (use long random strings, min 32 chars) ----
JWT_SECRET=change_this_to_a_very_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ---- E2EE (server never stores plaintext; used to encrypt push payloads) ----
# A static symmetric key the SERVER uses ONLY for transport-level encryption of
# delivery payloads. The TRUE E2EE layer lives client-side (see Flutter helper).
APP_SERVER_SECRET=change_this_to_another_long_secret_32_chars_min

# ---- Cloudinary (media & stickers) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Optional: Email (notifications / OTP reset) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=your_smtp_password
